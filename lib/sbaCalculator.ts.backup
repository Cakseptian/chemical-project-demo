// File: lib/sbaCalculator.ts

/**
 * 1. Menghitung Prediksi (Forecast) menggunakan WMA 3 Periode
 * Bobot standar: W1 = 0.5 (Terbaru), W2 = 0.3, W3 = 0.2 (Terlama)
 * @param data Array berisi 3 data aktual mingguan [Week-3, Week-2, Week-1]
 */
export const calculateWMA = (data: number[]): number => {
  if (data.length < 3) return 0; // Butuh minimal 3 minggu data
  
  // Memastikan data diambil dari 3 indeks terakhir
  const w3 = data[data.length - 3]; // Data terlama
  const w2 = data[data.length - 2];
  const w1 = data[data.length - 1]; // Data terbaru

  // Rumus WMA: (W1 * Actual1) + (W2 * Actual2) + (W3 * Actual3)
  const forecast = (w1 * 0.5) + (w2 * 0.3) + (w3 * 0.2);
  
  return Number(forecast.toFixed(2));
};

/**
 * 2. Menghitung Mean Absolute Deviation (MAD)
 * MAD mengukur seberapa jauh melesetnya prediksi kita dari kenyataan aktual.
 */
export const calculateMAD = (actuals: number[], forecasts: number[]): number => {
  if (actuals.length === 0 || actuals.length !== forecasts.length) return 0;

  let totalDeviation = 0;
  for (let i = 0; i < actuals.length; i++) {
    // Rumus deviasi absolut: | Actual - Forecast |
    totalDeviation += Math.abs(actuals[i] - forecasts[i]);
  }

  const mad = totalDeviation / actuals.length;
  return Number(mad.toFixed(2));
};

/**
 * 3. Menghitung Safety Stock (Buffer Aman)
 * Menggunakan pendekatan konversi MAD ke Standar Deviasi (Standard Deviation).
 * Standar Deviasi = 1.25 * MAD
 * Z-Score 1.65 merepresentasikan Service Level 95%
 */
export const calculateSafetyStock = (mad: number, zScore: number = 1.65): number => {
  // Rumus: Z-Score * (1.25 * MAD) * Akar dari Lead Time
  // Catatan: Karena lead time asumsinya konstan per minggu, faktor akarnya kita sederhanakan
  const standardDeviation = 1.25 * mad;
  const safetyStock = zScore * standardDeviation;
  
  // Safety stock kita bulatkan ke atas (Math.ceil) karena barang fisik tidak bisa pecah
  return Math.ceil(safetyStock);
};

/**
 * 4. Menghitung Reorder Point (ROP) - Titik Pemesanan Kembali
 * Saat stok aktual menyentuh angka ini, Admin harus beli ke supplier.
 */
export const calculateROP = (forecast: number, leadTime: number, safetyStock: number): number => {
  // Rumus: (Prediksi Pemakaian x Waktu Tunggu Kedatangan) + Safety Stock
  const rop = (forecast * leadTime) + safetyStock;
  return Math.ceil(rop);
};